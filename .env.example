# Copy this file to .env locally, then replace every placeholder.
# Never commit .env, the Firebase Admin JSON, or any real secrets.

# PostgreSQL (Supabase or local PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-db-password
DB_SCHEMA=public
DB_DDL_AUTO=update
DB_POOL_MAX=15
DB_POOL_MIN=3

# MongoDB
MONGO_URI=mongodb://localhost:27017/aloute_db

# JWT: generate a new random secret of at least 32 characters for your environment
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000

# Cloudinary (optional if the upload feature is not being tested)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (needed for email verification/password recovery)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ALOUTE <no-reply@localhost>
FRONTEND_BASE_URL=http://localhost:8080

# Browser/backend URLs
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
APP_SECURITY_COOKIE_SECURE=false
MODERATION_SERVICE_URL=http://localhost:8000
ALOUTE_SEED_DEMO_DATA=true
THYMELEAF_CACHE=false

# Firebase Web settings (copy from Firebase Console > Project settings > General > Web app)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_VAPID_KEY=your-public-vapid-key

# Firebase Admin SDK JSON stays outside Git. Each developer configures a local path.
# If stored in .secret/firebase-admin.json and Spring Boot is launched from project root:
FIREBASE_ADMIN_CREDENTIALS=.secret/firebase-admin.json
