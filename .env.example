# Set these in the process environment (or copy to .env for Docker Compose).
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_DDL_AUTO=update
DB_SCHEMA=public
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
MONGO_URI=mongodb://localhost:27017/aloute_db
# Generate a new random JWT signing secret, at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION=86400000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FRONTEND_BASE_URL=
APP_CORS_ALLOWED_ORIGINS=
APP_COOKIE_SECURE=true
SERVER_PORT=8080
MODERATION_SERVICE_URL=

# Upload limit shared by the servlet and chat upload validation.
ALOUTE_MAX_UPLOAD_SIZE=2GB
