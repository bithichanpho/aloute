# ALOUTE - mẫu cấu hình cho MỘT backend chạy trực tiếp trên máy (IDE/Maven/JAR).
# Sao chép thành .env nếu chưa có; thay các giá trị CHANGE_ME bằng thông tin của bạn.
# Không ghi đè .env đang dùng. Xem README.md, mục Cấu hình .env trước khi chạy.
# Java đọc file này như .properties: KEY=value, không thêm export hay dấu nháy bao giá trị.
# Lưu UTF-8; đường dẫn Windows dùng C:/... thay cho dấu gạch chéo ngược.
# Đặt chú thích trên dòng riêng. Không commit .env, khóa thật hay Firebase Admin JSON.

# Địa chỉ website - các giá trị phải khớp giao thức/host/cổng thực tế.
# localhost chỉ dùng trên chính máy chủ; LAN/Tailscale cần HTTPS để dùng mic/camera.
SERVER_PORT=8085
FRONTEND_BASE_URL=http://localhost:8085
APP_CORS_ALLOWED_ORIGINS=http://localhost:8085
APP_SECURITY_COOKIE_SECURE=false
APP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Tự khởi động Redis/moderation local bằng Docker, hoặc helper Windows/WSL đã cài.
# Không tự tạo PostgreSQL. Lần build đầu có thể cần vài phút.
LOCAL_SERVICES_AUTO_START=true
LOCAL_SERVICES_STARTUP_TIMEOUT=5m
SPRING_DOCKER_COMPOSE_ENABLED=false

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/aloute
# Docker Compose uses COMPOSE_DB_URL; localhost inside a container is not the host machine.
# For local host PostgreSQL, host.docker.internal is the default. For managed PostgreSQL, set this to its JDBC URL.
COMPOSE_DB_URL=jdbc:postgresql://host.docker.internal:5432/aloute
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=public
# Flyway manages schema changes; Hibernate validates mappings instead of mutating a shared DB.
# Use update only for a throwaway local database when intentionally needed.
DB_DDL_AUTO=validate
DB_POOL_MAX=15
DB_POOL_MIN=3

# JWT (replace with a cryptographically random secret of at least 32 bytes)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
# Khóa mã hóa dữ liệu bí mật: 32+ byte UTF-8, KHÁC JWT_SECRET và token moderation.
APP_SECURITY_ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
# Set this to the old JWT secret only during a planned one-time migration of existing encrypted TOTP data.
APP_SECURITY_LEGACY_ENCRYPTION_KEY=
APP_SECURITY_USER_CACHE_TTL=5s
JWT_EXPIRATION=900000
APP_REFRESH_TOKEN_DAYS=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=CHANGE_ME_VERIFIED_SENDER_EMAIL
# Cấu hình hiện tại dùng SMTP auth + STARTTLS. Xem README để dùng Mailpit local.

# Production uses the private Compose service. Do not publish its port publicly.
# If running Java directly on Windows, use http://localhost:8000 and expose only 127.0.0.1:8000 for the moderation container.
# Set both secrets to distinct random values; do not commit the real .env.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
MODERATION_API_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
MODERATION_ALLOWED_MEDIA_HOSTS=res.cloudinary.com
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_TIMEOUT_SECONDS=8
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_TIMEOUT_SECONDS=15
MODERATION_SERVICE_URL=http://localhost:8000
# Giữ true để chạy luồng kiểm duyệt. Lỗi khóa/quota/dịch vụ phải được xử lý tại nguồn.
MODERATION_ENABLED=true
MODERATION_CONNECT_TIMEOUT=2s
MODERATION_READ_TIMEOUT=60s
MODERATION_TEXT_TIMEOUT=10s
MODERATION_UPLOAD_MEDIA_TIMEOUT=12s
MODERATION_MAX_ATTEMPTS=5
MODERATION_RETRY_BASE_DELAY_SECONDS=30
MODERATION_LEASE_SECONDS=300

# Redis for direct Eclipse runs: start a Redis server bound to localhost:6379.
# This example assumes a local-only Redis without requirepass. For authenticated Redis,
# set REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379. Compose overrides the URL internally.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://localhost:6379
REDIS_CACHE_ENABLED=true
APP_CACHE_TTL=2m
APP_FEED_CACHE_TTL=30s
APP_HOST_DASHBOARD_CACHE_TTL=30s
RATE_LIMIT_REDIS_REQUIRED=false

# Firebase: tùy chọn cho Google login/FCM khi chạy Java local.
# Lấy cùng một Firebase project; để trống nếu chưa sử dụng hai chức năng này.
# Web config lấy từ Project settings > Your apps; VAPID cho push trên trình duyệt.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=
# JSON Admin chỉ ở server. Ví dụ C:/Users/YOUR_USER/.secret/firebase-admin.json.
# Nếu dùng Application Default Credentials thì có thể bỏ trống đường dẫn này.
# docker-compose.yml hiện tại BẮT BUỘC có file JSON thật để mount vào container.
FIREBASE_ADMIN_CREDENTIALS=

# Feature/bootstrap flags
APP_HOST_USERNAME=
# Enable once to promote the verified active account above to ROLE_HOST, then turn it off.
APP_HOST_BOOTSTRAP_ENABLED=false
APP_SEED_DEMO_ADMIN=false
ALOUTE_SEED_DEMO_DATA=false
ALOUTE_DB_RELATIONSHIP_MIGRATION=false
ALOUTE_MIGRATE_LEGACY_REPOST=false
ALOUTE_MAX_UPLOAD_SIZE=50MB
ALOUTE_MAX_UPLOAD_REQUEST_SIZE=52MB
# Một backend local dùng broker bộ nhớ, không cần RabbitMQ.
# docker-compose.yml tự ghi đè hai cờ này thành true và dùng broker nội bộ.
APP_REPLICAS=2
APP_WEBSOCKET_BROKER_RELAY_ENABLED=false
APP_CALLS_DISTRIBUTED_STATE_ENABLED=false
APP_WEBSOCKET_BROKER_RELAY_PORT=61613
RABBITMQ_USER=aloute
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/

TOMCAT_MAX_THREADS=150

PRESENCE_CONNECTION_TTL_MS=120000
PRESENCE_REFRESH_INTERVAL_MS=30000

# WebRTC: local chưa có TURN thì để trống APP_WEBRTC_TURN_URLS và khóa tương ứng.
# Nếu cần TURN, URL phải truy cập được từ CẢ HAI máy khách, khóa phải khớp Coturn.
APP_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
APP_WEBRTC_TURN_URLS=
APP_WEBRTC_TURN_SHARED_SECRET=
APP_WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600

# Riêng cho Coturn trong Docker Compose: thay host/IP trước khi dùng từ máy khác.
# Compose truyền TURN_SHARED_SECRET vào cả Java và Coturn để hai phía khớp nhau.
TURN_PUBLIC_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=aloute.local
TURN_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET

# Chuyển sang Docker: xem README, mục Chạy bằng Docker Compose.
# Điền COMPOSE_DB_URL, REDIS_PASSWORD, RABBITMQ_PASSWORD, TURN_SHARED_SECRET và file Admin.
# Đổi FRONTEND_BASE_URL/APP_CORS_ALLOWED_ORIGINS sang URL public (local Compose: cổng 8085).
# HTTP loopback: cookie-secure=false. HTTPS: true. Proxy CIDR phải khớp proxy thực tế.

# Background moderation throughput (bounded queues, no request-thread moderation).
MODERATION_EXECUTOR_CORE_SIZE=8
MODERATION_EXECUTOR_MAX_SIZE=16
MODERATION_EXECUTOR_QUEUE_CAPACITY=100

# OpenAPI/Swagger: disabled unless explicitly switched on for an admin-only dev session.
OPENAPI_ENABLED=false

# Keep scanner claims under the moderation executor's worker+queue capacity.
MODERATION_SCAN_LIMIT=100

# Delete abandoned post-purpose uploads and retry Cloudinary deletions.
POST_MEDIA_CLEANUP_INTERVAL_MS=3600000
POST_MEDIA_CLEANUP_INITIAL_DELAY_MS=300000
POST_MEDIA_ORPHAN_AGE_HOURS=2
POST_MEDIA_CLEANUP_SCAN_LIMIT=100
POST_MEDIA_DELETED_RETENTION_DAYS=30

# Retry durable cleanup jobs left after deleting a community.
COMMUNITY_CLEANUP_INITIAL_DELAY_MS=5000
COMMUNITY_CLEANUP_FIXED_DELAY_MS=30000
